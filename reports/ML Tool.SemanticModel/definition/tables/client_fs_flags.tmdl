		annotation SummarizationSetBy = Automatic

	partition client_fs_flags = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\client_fs_flags.csv"),
				    [Delimiter = ",", Columns = 9, QuoteStyle = QuoteStyle.Csv]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"flag_id", "color", "area", "headline", "detail", "recommended_action", "source_tab", "source_file", "value_class"}),
				  #"Changed Type" = #"Selected columns"
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
