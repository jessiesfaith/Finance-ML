	partition client_fs_ufcf = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\client_fs_ufcf.csv"),
				    [Delimiter = ",", Columns = 25, QuoteStyle = QuoteStyle.None]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"period_id", "forecast_method", "scenario", "review_status", "revenue", "revenue_growth_pct", "ebitda", "ebitda_margin_pct", "da", "ebit", "tax_rate_pct", "nopat", "accounts_receivable", "inventory", "other_operating_current_assets", "accounts_payable", "other_operating_current_liabilities", "operating_nwc", "delta_nwc", "capex", "ufcf"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {{"revenue", type number}, {"revenue_growth_pct", type number}, {"ebitda", type number}, {"ebitda_margin_pct", type number}, {"da", type number}, {"ebit", type number}, {"tax_rate_pct", type number}, {"nopat", type number}, {"accounts_receivable", type number}, {"inventory", type number}, {"other_operating_current_assets", type number}, {"accounts_payable", type number}, {"other_operating_current_liabilities", type number}, {"operating_nwc", type number}, {"delta_nwc", type number}, {"capex", type number}, {"ufcf", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

