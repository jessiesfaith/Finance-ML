/// Playbook ratios computed from the REAL filed 990 figures - each row shows its 990 formula and basis.
table nfp_990_ratio_actuals
	lineageTag: 881dacd0-db29-4b94-85a0-b119ff948d90

	measure '990 Op Margin FY24 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-OM-FY2024")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: cef67a75-72ac-4a6a-8387-f6a84c4aba38

	measure '990 Revenue Growth %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-RG-FY2024")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: bff9007f-b22c-4d3e-afc0-51d8f37877be

	measure '990 Expense Coverage FY24' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-EC-FY2024")
		formatString: 0.000
		displayFolder: NFP Cards
		lineageTag: aa3adc37-60dd-4ef1-a475-1f038d9a2c47

	measure '990 Real Ratios' =
			
			COUNTROWS(FILTER(nfp_990_ratio_actuals, NOT ISBLANK(nfp_990_ratio_actuals[value])))
		formatString: 0
		displayFolder: NFP Cards
		lineageTag: af0d4c96-ba36-4b59-9ae2-1657804554c7

