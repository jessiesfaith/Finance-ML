	column restriction
		dataType: string
		lineageTag: 8f1699c7-e668-44cd-aba3-fe816adfa29f
		summarizeBy: none
		sourceColumn: restriction

		annotation SummarizationSetBy = Automatic

	column signed
		dataType: string
		lineageTag: 0bdf45fa-577b-4898-8486-b25851c931c9
