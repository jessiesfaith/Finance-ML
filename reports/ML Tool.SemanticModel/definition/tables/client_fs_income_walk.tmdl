/// Curated pipeline export reports/client_fs_income_walk.csv: the income
/// summary in all three views (REPORTED / NORMALIZED / PROFORMA) per
/// period. The views are filters over one dataset, never separate books.
table client_fs_income_walk
	lineageTag: f11806e2-2faa-4c93-9876-29895cca911d

	/// As filed: 314.8 in the fixture.
	measure 'EBITDA Reported ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[ebitda]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "REPORTED"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: db588ce0-c348-4256-9eb0-7297dd4a6b12

	/// REPORTED plus APPROVED normalization adjustments (the
	/// fixture's one-time restructuring add-back): 326.8.
	/// Adjustments are additive rows - originals are never edited.
	measure 'EBITDA Normalized ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[ebitda]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "NORMALIZED"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: ed0accc2-6aca-47c5-8927-20a3debe218b

	/// NORMALIZED plus transaction pro-forma effects (the fixture's
	/// TXN-001 acquisition): 329.8.
	measure 'EBITDA Pro Forma ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[ebitda]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "PROFORMA"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: c5d088ac-f2a5-41c3-9e90-c47733de8a15

	measure 'Net Income Reported ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[net_income]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "REPORTED"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: 906ce500-78f6-4fe6-a840-32b413795fea

	measure 'Net Income Normalized ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[net_income]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "NORMALIZED"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: 0eba5b3c-e617-4c7c-957f-2ea56c19eb2d

	measure 'Net Income Pro Forma ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_income_walk[period_id]), ALL(client_fs_income_walk))
			RETURN
			    CALCULATE(
			        MAX(client_fs_income_walk[net_income]),
			        FILTER(
			            ALL(client_fs_income_walk),
			            client_fs_income_walk[period_id] = LatestPeriod && client_fs_income_walk[view] = "PROFORMA"
			        )
			    )
		formatString: #,0.0
		displayFolder: Three Views
		lineageTag: 0b45f5a0-a160-4042-a52c-915c9dca5ee1

	column view
