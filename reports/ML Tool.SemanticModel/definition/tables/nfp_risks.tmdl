	column mitigation
		dataType: string
		lineageTag: 58172b0c-db3b-4eee-a12d-e0d76ad89c00
		summarizeBy: none
		sourceColumn: mitigation

		annotation SummarizationSetBy = Automatic

	column inherent_note
		dataType: string
		lineageTag: 56759829-6e5f-4a26-9c71-3a60f360779a
		summarizeBy: none
		sourceColumn: inherent_note

		annotation SummarizationSetBy = Automatic

	column residual_likelihood
		dataType: double
		formatString: #,0.##;(#,0.##)
