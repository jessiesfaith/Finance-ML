		annotation SummarizationSetBy = Automatic

	partition client_fs_valuation_inputs = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\client_fs_valuation_inputs.csv"),
				    [Delimiter = ",", Columns = 22, QuoteStyle = QuoteStyle.None]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"period_id", "roic_basis", "short_term_debt", "long_term_debt", "finance_leases", "total_debt", "cash_and_equivalents", "restricted_cash", "net_debt", "invested_capital", "nopat", "roic_pct", "basic_shares_m", "diluted_shares_m"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {{"short_term_debt", type number}, {"long_term_debt", type number}, {"finance_leases", type number}, {"total_debt", type number}, {"cash_and_equivalents", type number}, {"restricted_cash", type number}, {"net_debt", type number}, {"invested_capital", type number}, {"nopat", type number}, {"roic_pct", type number}, {"basic_shares_m", type number}, {"diluted_shares_m", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

