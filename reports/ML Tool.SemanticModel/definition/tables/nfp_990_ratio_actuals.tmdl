/// Playbook ratios computed from the FILED 990 figures with the policy target / sector benchmark per ratio (target_class says which; vs_target = MEETS/MISSES).
table nfp_990_ratio_actuals
	lineageTag: 02610a95-1c42-48f2-98e8-61bd1016c41c

	measure '990 Op Margin FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-op_margin_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 3e2014b1-f973-4035-9b98-01c61998de82

	measure '990 Months Cash FY25' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-months_cash_on_hand-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: fefb6fdc-8ca1-4590-bc22-e7efd8c5a3c7

	measure '990 Revenue Growth FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-revenue_growth_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 06f664db-6297-49d7-915a-b2a8a827b5f4

	measure '990 Program Ratio FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-program_expense_ratio_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 7825cf83-0cb1-4f11-9723-81b9f530c2e2

	measure '990 Real Ratios' =
			
			COUNTROWS(FILTER(nfp_990_ratio_actuals, NOT ISBLANK(nfp_990_ratio_actuals[value])))
		formatString: 0
		displayFolder: NFP Cards
		lineageTag: b5a2a64e-bd4c-48fd-84b4-a58830c30203

	measure 'Reserve Months FY25' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-operating_reserve_months-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: b97e9b1a-6023-477e-b866-c59941f92e86

	measure 'Revenue Concentration FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-revenue_concentration_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 23e1496c-a53e-4ca2-99e1-f8871f5e0a78

