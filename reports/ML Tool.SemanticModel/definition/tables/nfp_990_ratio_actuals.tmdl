/// Playbook ratios computed from the FILED 990 figures for every filed year - ratio_kind filters one ratio across years for trend charts.
table nfp_990_ratio_actuals
	lineageTag: c8fd50ab-af84-4aa9-80a0-46487c0eec90

	measure '990 Op Margin FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-op_margin_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: f0d8da79-462d-47cf-8526-41b2171500c2

	measure '990 Months Cash FY25' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-months_cash_on_hand-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 87281821-01a7-4531-8bdc-c3a68398836d

	measure '990 Revenue Growth FY25 %' =
			
			CALCULATE(SUM(nfp_990_ratio_actuals[value]), nfp_990_ratio_actuals[ratio_id] = "R990-revenue_growth_pct-FY2025")
		formatString: 0.00
		displayFolder: NFP Cards
		lineageTag: 39a256e0-b0f8-4e1f-88ae-ee3a791c6e31

	measure '990 Real Ratios' =
			
			COUNTROWS(FILTER(nfp_990_ratio_actuals, NOT ISBLANK(nfp_990_ratio_actuals[value])))
		formatString: 0
		displayFolder: NFP Cards
		lineageTag: 113e8c96-6745-45f0-900f-9cf68a0737df

	column row_id
		dataType: string
		lineageTag: 2533d53d-3fe6-4e99-a8a3-1682c436a515
		summarizeBy: none
		sourceColumn: row_id

		annotation SummarizationSetBy = Automatic

