/// Curated pipeline export reports/client_fs_valuation_inputs.csv:
/// net-debt components, invested capital / ROIC, and the diluted-share
/// build. Python writes it; the report only reads.
table client_fs_valuation_inputs
	lineageTag: 9878f1a3-4a41-48a6-aecb-ecb2fd538a63

	/// CLIENT F/S: short-term + long-term debt + finance leases
	/// (366.0 in the fixture), classified via account_mapping -
	/// never a typed-in number.
	measure 'Client Total Debt ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[total_debt]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: #,0.0
		displayFolder: Capital Base
		lineageTag: db05b542-e195-4718-9b25-5871e4753609

	measure 'Client Cash ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[cash_and_equivalents]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: #,0.0
		displayFolder: Capital Base
		lineageTag: 2a685359-d523-421b-a979-851a790c92c1

	/// Total debt - cash = 172.0. The same pipeline number Page 1
	/// reads from finance_scenario_report.csv to bridge enterprise
	/// value to equity value.
	measure 'Client Net Debt ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[net_debt]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: #,0.0
		displayFolder: Capital Base
		lineageTag: 40b67213-f52d-4695-bdc4-d2baa5c0e1eb

	/// Operating NWC + net PP&E (+ other operating, net) = 791.5 -
	/// the capital base under ROIC, statement-derived.
	measure 'Client Invested Capital ($M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[invested_capital]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: #,0.0
		displayFolder: Capital Base
		lineageTag: f8f8fc50-6092-4d95-b3fd-b05987be0822

	measure 'Client ROIC (%)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[roic_pct]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: 0.00
		displayFolder: Capital Base
		lineageTag: a01706f9-aeb6-4655-b132-f4ac5690f8d5

	measure 'Client Basic Shares (M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[basic_shares_m]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: 0.0
		displayFolder: Capital Base
		lineageTag: c571d0ff-8ab7-46eb-b2e6-4f1c77817018

	/// Basic shares + treasury-stock-method dilution = 103.7.
	/// Divides equity value into the implied share price on Page 1.
	measure 'Client Diluted Shares (M)' =
			
			VAR LatestPeriod = CALCULATE(MAX(client_fs_valuation_inputs[period_id]), ALL(client_fs_valuation_inputs))
			RETURN
			    CALCULATE(
			        MAX(client_fs_valuation_inputs[diluted_shares_m]),
			        FILTER(
			            ALL(client_fs_valuation_inputs),
			            client_fs_valuation_inputs[period_id] = LatestPeriod
			        )
			    )
		formatString: 0.0
		displayFolder: Capital Base
		lineageTag: b02ba3c3-9a27-451b-8820-a5e4f0b6a052

	/// In-the-money options exercised on paper; proceeds buy back
	/// shares at the market price; the remainder dilutes.
	measure 'Client TSM Dilution (M)' =
			
			[Client Diluted Shares (M)] - [Client Basic Shares (M)]
		formatString: 0.0
		displayFolder: Capital Base
		lineageTag: bc5a0a0c-0694-4b94-9c13-3308361f601a

