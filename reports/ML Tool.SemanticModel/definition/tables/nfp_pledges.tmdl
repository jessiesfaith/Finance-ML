/// Curated NFP export: pledge collection tracking and expected cash.
table nfp_pledges
	lineageTag: 959713ed-cb05-4a4d-b9ce-87c6d7710f9d

	measure 'Pledges Outstanding ($)' =
			
			SUM(nfp_pledges[outstanding])
		formatString: #,0
		displayFolder: NFP Cards
		lineageTag: a1b478ff-2190-4ab2-b033-7731cbb82548

	measure 'Expected Pledge Cash ($)' =
			
			SUM(nfp_pledges[expected_pledge_cash])
		formatString: #,0
		displayFolder: NFP Cards
		lineageTag: a79e1a13-e83e-494f-b6b5-69d2e9058ee9

	column row_id
		dataType: string
		lineageTag: f22002ac-38ef-4228-8778-5e6ba41aa26e
		summarizeBy: none
		sourceColumn: row_id

		annotation SummarizationSetBy = Automatic

	column pledge_id
		dataType: string
		lineageTag: c69eb596-beb1-4be3-a23f-90893833d319
		summarizeBy: none
		sourceColumn: pledge_id

		annotation SummarizationSetBy = Automatic

	column donor
		dataType: string
		lineageTag: a9c5409d-4184-458a-a0c3-d957e14cd03d
		summarizeBy: none
		sourceColumn: donor

		annotation SummarizationSetBy = Automatic

	column amount
		dataType: double
		formatString: #,0.##
		lineageTag: 690dcdf0-922c-41b4-bc15-503783dcbb57
		summarizeBy: none
