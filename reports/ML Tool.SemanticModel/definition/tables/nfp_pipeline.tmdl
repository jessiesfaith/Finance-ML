		sourceColumn: cash_window

		annotation SummarizationSetBy = Automatic

	partition nfp_pipeline = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\nfp_pipeline.csv"),
				    [Delimiter = ",", Columns = 16, QuoteStyle = QuoteStyle.Csv]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"row_id", "pipeline_id", "donor_funder", "stage", "potential_amount", "probability_pct", "probability_basis", "ask_date", "expected_cash_date", "restricted", "program_id", "owner_role", "next_action", "value_class", "expected_value", "cash_window"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {
				    {"row_id", type text},
				    {"pipeline_id", type text},
				    {"donor_funder", type text},
				    {"stage", type text},
				    {"potential_amount", type number},
				    {"probability_pct", type number},
				    {"probability_basis", type text},
				    {"ask_date", type text},
				    {"expected_cash_date", type text},
				    {"restricted", type text},
				    {"program_id", type text},
				    {"owner_role", type text},
				    {"next_action", type text},
				    {"value_class", type text},
				    {"expected_value", type number},
				    {"cash_window", type text}
				  })
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
