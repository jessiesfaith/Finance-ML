/// Curated NFP export: executive decision page + CFO script + board debate + controls.
table nfp_exec_board
	lineageTag: 42df9e0c-018f-4f47-b3d6-4a0e0e621d6c

	column row_id
		dataType: string
		lineageTag: 6d4cdd36-43ff-4a2c-8063-6eff270911fa
		summarizeBy: none
