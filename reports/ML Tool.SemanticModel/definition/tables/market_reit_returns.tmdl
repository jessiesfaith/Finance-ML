/// Top-5 REIT calendar-year total returns 2017-2025 + 2026 YTD (PUBLIC_RESEARCH, MEDIUM; two cells honestly blank).
table market_reit_returns
	lineageTag: 17cfce6c-3796-4a8a-ac91-685c732975f2

	measure 'REIT WELL total return %' =
			
			CALCULATE(SUM(market_reit_returns[return_pct]), market_reit_returns[ticker] = "WELL")
		formatString: #,0.##;(#,0.##)
		displayFolder: REIT
		lineageTag: de68c593-b8c8-4f92-a354-5c24733035a9

	measure 'REIT PLD total return %' =
			
			CALCULATE(SUM(market_reit_returns[return_pct]), market_reit_returns[ticker] = "PLD")
		formatString: #,0.##;(#,0.##)
		displayFolder: REIT
		lineageTag: aebcf569-4bed-482c-bac1-7d6266512d25

	measure 'REIT EQIX total return %' =
			
			CALCULATE(SUM(market_reit_returns[return_pct]), market_reit_returns[ticker] = "EQIX")
		formatString: #,0.##;(#,0.##)
		displayFolder: REIT
		lineageTag: d9be8668-abd7-4b6c-a7f0-9b7ce8210aab

	measure 'REIT AMT total return %' =
			
			CALCULATE(SUM(market_reit_returns[return_pct]), market_reit_returns[ticker] = "AMT")
		formatString: #,0.##;(#,0.##)
		displayFolder: REIT
		lineageTag: fe5da10e-2e9d-46c1-b140-fd0353958177

	measure 'REIT DLR total return %' =
			
			CALCULATE(SUM(market_reit_returns[return_pct]), market_reit_returns[ticker] = "DLR")
		formatString: #,0.##;(#,0.##)
		displayFolder: REIT
		lineageTag: dc21206a-1679-41c8-a9ba-c470dc83e3af

