		annotation SummarizationSetBy = Automatic

	column section
		dataType: string
		lineageTag: 88064bcb-39b0-480a-b98f-ade1422b2aca
		summarizeBy: none
		sourceColumn: section

		annotation SummarizationSetBy = Automatic

	column item
		dataType: string
		lineageTag: 249febd5-4f45-4d77-a1ad-e50a5b61d5dc
		summarizeBy: none
		sourceColumn: item

		annotation SummarizationSetBy = Automatic

	column value_text
		dataType: string
		lineageTag: 33da801b-489b-4f68-8999-26a749816278
		summarizeBy: none
		sourceColumn: value_text

		annotation SummarizationSetBy = Automatic

	column status
		dataType: string
		lineageTag: 2df82c5f-7490-4b1b-b714-35ef7ac4fb7a
