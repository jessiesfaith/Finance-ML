		annotation SummarizationSetBy = Automatic

	column expected_date
		dataType: string
		lineageTag: 7bfdc9e5-b6e7-471c-ba46-f18094a1370f
		summarizeBy: none
		sourceColumn: expected_date

		annotation SummarizationSetBy = Automatic

	column collection_probability_pct
		dataType: double
		formatString: #,0.##
		lineageTag: 70d14e45-8fca-4795-8b3e-621522795807
		summarizeBy: none
		sourceColumn: collection_probability_pct

		annotation SummarizationSetBy = Automatic

	column days_past_due
		dataType: double
		formatString: #,0.##
		lineageTag: f8bd483a-ce8c-4edd-9cd8-691bc6a7539c
		summarizeBy: none
		sourceColumn: days_past_due

		annotation SummarizationSetBy = Automatic

	column value_class
		dataType: string
		lineageTag: 269d04ee-df8b-4100-995a-1e1f398ab7a3
		summarizeBy: none
		sourceColumn: value_class

		annotation SummarizationSetBy = Automatic

	column outstanding
		dataType: double
		formatString: #,0.##
		lineageTag: c2aac599-acc8-4614-bcab-2f27bb4753d3
		summarizeBy: none
		sourceColumn: outstanding

		annotation SummarizationSetBy = Automatic

	column expected_pledge_cash
		dataType: double
		formatString: #,0.##
		lineageTag: b8c87c77-5cef-446b-ad6f-7539ac353b0b
