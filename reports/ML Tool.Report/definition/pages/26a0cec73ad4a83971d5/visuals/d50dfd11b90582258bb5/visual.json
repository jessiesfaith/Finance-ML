              {
                "textRuns": [
                  {
                    "value": "4 \u00b7 The Income Walk \u2014 from scratch",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Start from a single sale: cash in is revenue. Running the operation \u2014 people, materials, rent \u2014 costs money; what remains is cash operating profit: EBITDA = revenue \u2212 operating costs = 1,274.0 \u2212 959.2 = 314.8.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Machines and software wear out. D&A spreads that real (but non-cash) wear over the years it serves: EBIT = EBITDA \u2212 D&A = 314.8 \u2212 66.2 = 248.6.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The state takes its share of operating profit: NOPAT = EBIT \u00d7 (1 \u2212 tax) = 248.6 \u00d7 0.75 = 186.5 \u2014 the profit the operation truly keeps.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2192 tab 1 \u00b7 Client Financials and tab 8 \u00b7 Calc Build-Out",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
