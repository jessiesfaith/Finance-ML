		sourceColumn: value_class

		annotation SummarizationSetBy = Automatic

	partition nfp_risks = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\nfp_risks.csv"),
				    [Delimiter = ",", Columns = 14, QuoteStyle = QuoteStyle.Csv]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"row_id", "risk_id", "risk", "likelihood", "impact", "response", "mitigation", "inherent_note", "residual_likelihood", "owner_role", "monitoring_metric", "inherent_score", "residual_score", "value_class"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {
				    {"row_id", type text},
				    {"risk_id", type text},
				    {"risk", type text},
				    {"likelihood", type number},
				    {"impact", type number},
				    {"response", type text},
				    {"mitigation", type text},
				    {"inherent_note", type text},
				    {"residual_likelihood", type number},
				    {"owner_role", type text},
				    {"monitoring_metric", type text},
				    {"inherent_score", type number},
				    {"residual_score", type number},
				    {"value_class", type text}
				  })
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
