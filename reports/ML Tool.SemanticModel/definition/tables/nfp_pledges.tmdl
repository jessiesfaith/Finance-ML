		annotation SummarizationSetBy = Automatic

	partition nfp_pledges = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\nfp_pledges.csv"),
				    [Delimiter = ",", Columns = 16, QuoteStyle = QuoteStyle.Csv]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"row_id", "pledge_id", "donor", "amount", "collected", "restriction", "signed", "expected_date", "collection_probability_pct", "days_past_due", "value_class", "outstanding", "expected_pledge_cash", "collection_pct", "past_due_flag", "pledge_date"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {
				    {"row_id", type text},
				    {"pledge_id", type text},
				    {"donor", type text},
				    {"amount", type number},
				    {"collected", type number},
				    {"restriction", type text},
				    {"signed", type text},
				    {"expected_date", type text},
				    {"collection_probability_pct", type number},
				    {"days_past_due", type number},
				    {"value_class", type text},
				    {"pledge_date", type text},
				    {"outstanding", type number},
				    {"expected_pledge_cash", type number},
				    {"collection_pct", type number},
				    {"past_due_flag", type text}
				  })
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
