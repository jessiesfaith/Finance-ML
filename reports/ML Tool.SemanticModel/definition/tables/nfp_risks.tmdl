	column monitoring_metric
		dataType: string
		lineageTag: 5292d6e1-5c02-4091-825c-fb9a3aa2fdec
		summarizeBy: none
		sourceColumn: monitoring_metric

		annotation SummarizationSetBy = Automatic

	column inherent_score
		dataType: double
		formatString: #,0.##;(#,0.##)
		lineageTag: 20ac5e0c-8291-44fa-9c39-640255e0df87
		summarizeBy: none
		sourceColumn: inherent_score

		annotation SummarizationSetBy = Automatic

	column residual_score
