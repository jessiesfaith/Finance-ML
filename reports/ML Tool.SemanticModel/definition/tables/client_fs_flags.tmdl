/// Curated export: the red/green notification feed - every
/// health check, option verdict and open control finding as one
/// row, colored RED (act) / YELLOW (review) / GREEN (confirmed).
table client_fs_flags
	lineageTag: 35784a6d-2e00-4d6c-95a9-3aee1f33c3a0

	measure 'Red Flags' =
			
			CALCULATE(COUNTROWS(client_fs_flags), client_fs_flags[color] = "RED")
		formatString: 0
		displayFolder: Flags
		lineageTag: 8298018f-7b42-4e29-9a35-8b4ad420d17f

	measure 'Yellow Flags' =
			
			CALCULATE(COUNTROWS(client_fs_flags), client_fs_flags[color] = "YELLOW")
		formatString: 0
		displayFolder: Flags
		lineageTag: 3c3aca3d-9745-41a5-94e6-5ea8a10d8d7a

	measure 'Green Flags' =
			
			CALCULATE(COUNTROWS(client_fs_flags), client_fs_flags[color] = "GREEN")
		formatString: 0
		displayFolder: Flags
		lineageTag: 94dc6887-98fa-423a-ab9d-d7758b9def12

	column flag_id
		dataType: string
		lineageTag: c92f1433-02fa-414a-adb7-86afb39c9dc6
		summarizeBy: none
		sourceColumn: flag_id

		annotation SummarizationSetBy = Automatic

	column color
		dataType: string
		lineageTag: 0ff58717-5402-4756-8c45-bede16972b7f
