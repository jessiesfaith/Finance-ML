table client_fs_ufcf
	lineageTag: 8beca4d3-b8ad-4e6b-9cf6-dd491483ee63

	/// The most recent period whose rows are ACTUAL statements. Every
	/// 'Client ...' measure reads this year, so nothing on Page 2 is
	/// hard-coded to a fiscal year.
	measure 'Latest Actual Period' =
			
			CALCULATE(
			    MAX(client_fs_ufcf[period_id]),
			    FILTER(ALL(client_fs_ufcf), client_fs_ufcf[forecast_method] = "ACTUAL")
			)
		displayFolder: Income Walk
		lineageTag: c0c35d5d-7d1e-4f02-a861-d9d4cadd8ecc

	/// CLIENT F/S: consolidated revenue after mapping, sign normalization,
	/// FX translation and eliminations (1,274.0 in the fixture).
	measure 'Client Revenue ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[revenue]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: 1cc85026-48b6-4a28-b9ff-d74b2fc68a14

	measure 'Client EBITDA ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[ebitda]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: 29af9bcd-0315-4f0e-9dff-1f1829de65d3

	/// Revenue minus EBITDA: everything above the EBITDA line, shown so the
	/// first equation row is complete on screen.
	measure 'Client Operating Costs ($M)' =
			
			[Client Revenue ($M)] - [Client EBITDA ($M)]
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: 007aba34-0bab-475e-b8ac-da5651f09d86

	measure 'Client D&A ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[da]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: f33b9fa5-8109-459f-ac9e-fd50ab1392d9

	measure 'Client EBIT ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[ebit]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: 750dba3d-073d-4f6a-ad46-ba852f78f7b7

	measure 'Client Tax Rate (%)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[tax_rate_pct]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: 0.0
		displayFolder: Income Walk
		lineageTag: 5126fb29-8a9f-4eda-8aed-e942d1da18b5

	measure 'Client After-Tax Factor' =
			
			1 - DIVIDE([Client Tax Rate (%)], 100)
		formatString: 0.00
		displayFolder: Income Walk
		lineageTag: c6f16dc7-a6a2-44e5-b279-adee85d0ff08

	/// EBIT x (1 - tax) as the pipeline computed it (src/financials/ufcf.py).
	/// The card shows the pipeline's own number beside the on-page equation,
	/// so the walk is verifiable, not decorative.
	measure 'Client NOPAT ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[nopat]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Income Walk
		lineageTag: 3506aeb7-28c0-45e3-96ab-dddd1c3b4c1e

	measure 'Client AR ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[accounts_receivable]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: e94e8377-5fe4-4414-8a16-16c60ecc5336

	measure 'Client Inventory ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[inventory]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 86e2c8c1-bf35-4571-aace-6348167b923d

	measure 'Client Other Op CA ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[other_operating_current_assets]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 43c93dfd-4c95-4e37-befb-a49d360fb81a

	measure 'Client AP ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[accounts_payable]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 2cef4d10-6435-448d-ba34-4a595dee9044

	measure 'Client Other Op CL ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[other_operating_current_liabilities]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 4edf7f08-110d-4e8c-a973-cfd0c06d772c

	/// AR + inventory + other operating CA - AP - other operating CL
	/// (159.5 in the fixture). Operating items only - no cash, no debt.
	measure 'Client Operating NWC ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[operating_nwc]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 76d10947-a20d-4b8c-ac4f-6f74db7c1c2f

	/// Operating NWC of the prior ACTUAL year (133.2), so the change in NWC
	/// is visible as a subtraction, not an unexplained number.
	measure 'Client Prior NWC ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			VAR PriorActual =
			    CALCULATE(
			        MAX(client_fs_ufcf[period_id]),
			        FILTER(
			            ALL(client_fs_ufcf),
			            client_fs_ufcf[forecast_method] = "ACTUAL"
			                && client_fs_ufcf[period_id] < LatestActual
			        )
			    )
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[operating_nwc]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = PriorActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: ef3c31d4-980e-4f64-b333-1581995ebbe3

	/// 159.5 - 133.2 = +26.3 in the fixture. An INCREASE in net working
	/// capital is a use of cash, which is why the UFCF bridge subtracts it.
	measure 'Client Change in NWC ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[delta_nwc]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Working Capital
		lineageTag: 7f02bdee-98a5-4188-9232-01094fa9f767

	measure 'Client CapEx ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[capex]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Free Cash Flow
		lineageTag: 4fe01592-a91b-425e-ae82-92127349b333

	/// NOPAT + D&A - CapEx - change in NWC (156.4 in the fixture). This is
	/// the number the driver forecast extends and Page 1's DCF discounts -
	/// it replaced the hard-coded fcf = [100, 110, 121, 133, 146].
	measure 'Client UFCF ($M)' =
			
			VAR LatestActual = [Latest Actual Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[ufcf]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = LatestActual)
			    )
		formatString: #,0.0
		displayFolder: Free Cash Flow
		lineageTag: b2644fd7-f0ce-4cd9-8775-0297ef79ce10

	/// Rebuilds UFCF from its parts and subtracts the pipeline's UFCF -
	/// must read 0.00. Same idea as DCF Model Check on Page 1.
	measure 'UFCF Bridge Check ($M)' =
			
			[Client NOPAT ($M)] + [Client D&A ($M)]
			    - [Client CapEx ($M)] - [Client Change in NWC ($M)]
			    - [Client UFCF ($M)]
		formatString: 0.00
		displayFolder: Free Cash Flow
		lineageTag: 8036f6d6-c425-4269-9581-147048ab1d34

	/// The first DRIVER_BASED year - the driver cards read their
	/// assumptions from this row.
	measure 'First Forecast Period' =
			
			CALCULATE(
			    MIN(client_fs_ufcf[period_id]),
			    FILTER(ALL(client_fs_ufcf), client_fs_ufcf[forecast_method] = "DRIVER_BASED")
			)
		displayFolder: Forecast Drivers
		lineageTag: 697df77f-c45f-47be-95f1-eb83a5fbb9dd

	/// ASSUMPTION from data/scenarios/scenario_assumptions.csv - every
	/// driver carries a rationale and approval status, never arbitrary.
	measure 'Driver Revenue Growth (%)' =
			
			VAR FirstForecast = [First Forecast Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[revenue_growth_pct]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
		formatString: 0.0
		displayFolder: Forecast Drivers
		lineageTag: 64593e6c-4a35-4c06-ab3d-cf81a06640a3

	measure 'Driver EBITDA Margin (%)' =
			
			VAR FirstForecast = [First Forecast Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[ebitda_margin_pct]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
		formatString: 0.0
		displayFolder: Forecast Drivers
		lineageTag: 49bc60f9-d267-429b-aa8f-95cc029cc45e

	measure 'Driver D&A (% of Revenue)' =
			
			VAR FirstForecast = [First Forecast Period]
			VAR DA =
			    CALCULATE(
			        MAX(client_fs_ufcf[da]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
			VAR Revenue =
			    CALCULATE(
			        MAX(client_fs_ufcf[revenue]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
			RETURN
			    100 * DIVIDE(DA, Revenue)
		formatString: 0.0
		displayFolder: Forecast Drivers
		lineageTag: 4d86de39-e487-4983-8f9d-f1beb5ea644c

	measure 'Driver CapEx (% of Revenue)' =
			
			VAR FirstForecast = [First Forecast Period]
			VAR CapEx =
			    CALCULATE(
			        MAX(client_fs_ufcf[capex]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
			VAR Revenue =
			    CALCULATE(
			        MAX(client_fs_ufcf[revenue]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
			RETURN
			    100 * DIVIDE(CapEx, Revenue)
		formatString: 0.0
		displayFolder: Forecast Drivers
		lineageTag: 27330fb1-668f-459c-9c7f-ebe803256065

	measure 'Driver Tax Rate (%)' =
			
			VAR FirstForecast = [First Forecast Period]
			RETURN
			    CALCULATE(
			        MAX(client_fs_ufcf[tax_rate_pct]),
			        FILTER(ALL(client_fs_ufcf), client_fs_ufcf[period_id] = FirstForecast)
			    )
		formatString: 0.0
		displayFolder: Forecast Drivers
		lineageTag: 40431e58-baa6-4aa4-a768-32e0b7b0b55c

