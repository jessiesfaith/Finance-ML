	partition client_fs_income_walk = m
		mode: import
		source =
				let
				  Source = Csv.Document(
				    File.Contents("C:\dev\Finance-ML\reports\client_fs_income_walk.csv"),
				    [Delimiter = ",", Columns = 11, QuoteStyle = QuoteStyle.None]
				),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Selected columns" = Table.SelectColumns(#"Promoted headers", {"view", "period_id", "revenue", "ebitda", "ebitda_margin_pct", "ebit", "ebit_margin_pct", "net_income"}),
				  #"Changed Type" = Table.TransformColumnTypes(#"Selected columns", {{"revenue", type number}, {"ebitda", type number}, {"ebitda_margin_pct", type number}, {"ebit", type number}, {"ebit_margin_pct", type number}, {"net_income", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

