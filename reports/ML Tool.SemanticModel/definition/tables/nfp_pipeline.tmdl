	column restricted
		dataType: string
		lineageTag: 3473e43a-15f9-409e-b962-f79b87fea74a
		summarizeBy: none
		sourceColumn: restricted

		annotation SummarizationSetBy = Automatic

	column program_id
		dataType: string
		lineageTag: d411975f-5f33-4e0c-a476-06dca1667786
		summarizeBy: none
		sourceColumn: program_id

		annotation SummarizationSetBy = Automatic

	column owner_role
		dataType: string
		lineageTag: 4bc36983-dfb8-4c4d-adbf-fae9b9c19a95
		summarizeBy: none
		sourceColumn: owner_role

		annotation SummarizationSetBy = Automatic

	column next_action
